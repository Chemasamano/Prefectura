# Copia este archivo a .env y ajusta los valores

# Desarrollo local (SQLite, no requiere instalar nada mas):
DATABASE_URL="file:./dev.db"

# --- Para producción con PostgreSQL, comenta la linea de arriba y usa esta: ---
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd?schema=public"

# Cambia esto por una cadena larga y aleatoria antes de desplegar en produccion
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Duracion de la sesion de un prefecto (formato: 12h, 1d, etc.)
JWT_EXPIRES_IN="12h"

PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend)
CORS_ORIGIN="http://localhost:5173"

# Credenciales del usuario administrador inicial (solo se usan al ejecutar el seed)
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_PASSWORD="CambiaEstaClave123"
SEED_ADMIN_NOMBRE="Administrador"
